datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String              @id @default(cuid()) @db.VarChar(191)
  username           String              @unique @db.VarChar(100)
  email              String              @unique @db.VarChar(191)
  password           String              @db.VarChar(255)
  fullName           String?             @db.VarChar(255)
  unit               String?             @db.VarChar(255)
  phone              String?             @db.VarChar(100)
  roleId             String              @db.VarChar(191)
  role               Role                @relation(fields: [roleId], references: [id])
  isActive           Boolean             @default(true)
  startDate          String?             @db.VarChar(50)
  dob                String?             @db.VarChar(50)
  bhxh               String?             @db.VarChar(100)
  cccd               String?             @db.VarChar(50)
  cccdDate           String?             @db.VarChar(50)
  cccdPlace          String?             @db.VarChar(255)
  address            String?             @db.Text
  idFiles            Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  projectPermissions ProjectPermission[]

  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid()) @db.VarChar(191)
  name        String   @unique @db.VarChar(100)
  displayName String   @db.VarChar(255)
  description String?  @db.Text
  permissions Json
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model ProjectPermission {
  id        String   @id @default(cuid()) @db.VarChar(191)
  projectId String   @db.VarChar(191)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String   @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  access    String   @default("viewer") @db.VarChar(50) // 'owner' | 'editor' | 'viewer'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Project {
  id                 String              @id @default(cuid()) @db.VarChar(191)
  name               String              @db.VarChar(255)
  color              String              @default("#2563eb") @db.VarChar(50)
  note               String?             @db.Text
  dueDate            String?             @db.VarChar(50)
  groupId            String?             @db.VarChar(191)
  stage              String?             @db.VarChar(100)
  contractValue      Float?
  retentionPct       Float?              @default(5)
  budget             Json?
  info               Json?
  folders            Json?
  files              Json?
  deleted            Boolean             @default(false)
  updatedBy          String?             @db.VarChar(191)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tasks              Task[]
  projectPermissions ProjectPermission[]
  netlabTopology     NetlabTopology?

  @@index([deleted])
  @@index([groupId])
}

model Task {
  id        String   @id @default(cuid()) @db.VarChar(191)
  projectId String?  @db.VarChar(191)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folderId  String?  @db.VarChar(191)
  title     String   @db.VarChar(500)
  note      String?  @db.Text
  status    String   @default("todo") @db.VarChar(50)
  priority  String   @default("med")  @db.VarChar(50)
  progress  Int      @default(0)
  sort      Int      @default(10)
  startDate String?  @db.VarChar(50)
  dueDate   String?  @db.VarChar(50)
  assignee  String?  @db.VarChar(500)
  assigner  String?  @db.VarChar(191)
  files     Json?
  checklist Json?
  color     String?  @db.VarChar(50)
  doneAt    String?  @db.VarChar(50)
  deleted   Boolean  @default(false)
  updatedBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, deleted])
  @@index([status, deleted])
}

model Member {
  id        String   @id @default(cuid()) @db.VarChar(191)
  name      String   @db.VarChar(255)
  fullName  String?  @db.VarChar(255)
  email     String   @unique @db.VarChar(191)
  unit      String?  @db.VarChar(255)
  phone     String?  @db.VarChar(100)
  deleted   Boolean  @default(false)
  updatedBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deleted])
}

model Field {
  id        String   @id @default(cuid()) @db.VarChar(191)
  label     String   @db.VarChar(255)
  type      String   @default("text") @db.VarChar(50)
  unit      String?  @db.VarChar(50)
  group     String   @default("Thông tin chung") @db.VarChar(255)
  options   String?  @db.Text
  sort      Int      @default(10)
  deleted   Boolean  @default(false)
  updatedBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deleted])
}

model ProjectGroup {
  id        String   @id @default(cuid()) @db.VarChar(191)
  name      String   @db.VarChar(255)
  sort      Int      @default(10)
  deleted   Boolean  @default(false)
  updatedBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deleted])
}

model Category {
  id        String   @id @default(cuid()) @db.VarChar(191)
  name      String   @db.VarChar(255)
  kind      String   @default("chi") @db.VarChar(50)
  sort      Int      @default(10)
  deleted   Boolean  @default(false)
  updatedBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deleted])
}

model Diary {
  id             String   @id @default(cuid()) @db.VarChar(191)
  projectId      String   @db.VarChar(191)
  date           String   @db.VarChar(50)
  weatherAM      String?  @db.VarChar(100)
  weatherPM      String?  @db.VarChar(100)
  folderId       String?  @db.VarChar(191)
  area           String?  @db.VarChar(255)
  workText       String?  @db.Text
  tasks          Json?
  quantities     Json?
  labor          Json?
  machines       Json?
  materials      Json?
  safety         String?  @db.Text
  issues         String?  @db.Text
  proposals      String?  @db.Text
  supervisorNote String?  @db.Text
  files          Json?
  confirmedBy    String?  @db.VarChar(191)
  confirmedAt    String?  @db.VarChar(50)
  deleted        Boolean  @default(false)
  createdBy      String?  @db.VarChar(191)
  updatedBy      String?  @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, deleted])
  @@index([date])
}

model Ledger {
  id           String   @id @default(cuid()) @db.VarChar(191)
  projectId    String   @db.VarChar(191)
  date         String   @db.VarChar(50)
  kind         String   @default("chi") @db.VarChar(50)
  categoryId   String?  @db.VarChar(191)
  folderId     String?  @db.VarChar(191)
  content      String   @db.Text
  unit         String?  @db.VarChar(50)
  qty          Float?
  price        Float?
  amount       Float    @default(0)
  person       String?  @db.VarChar(191)
  note         String?  @db.Text
  files        Json?
  status       String   @default("pending") @db.VarChar(50)
  approvedBy   String?  @db.VarChar(191)
  approvedAt   String?  @db.VarChar(50)
  rejectReason String?  @db.Text
  deleted      Boolean  @default(false)
  createdBy    String?  @db.VarChar(191)
  updatedBy    String?  @db.VarChar(191)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId, deleted])
  @@index([status, deleted])
}

model Worker {
  id        String   @id @default(cuid()) @db.VarChar(191)
  name      String   @db.VarChar(255)
  team      String?  @db.VarChar(255)
  job       String?  @db.VarChar(255)
  phone     String?  @db.VarChar(100)
  payType   String   @default("day") @db.VarChar(50)
  rate      Float    @default(0)
  bank      String?  @db.VarChar(255)
  note      String?  @db.Text
  active    Boolean  @default(true)
  sort      Int      @default(10)
  deleted   Boolean  @default(false)
  createdBy String?  @db.VarChar(191)
  updatedBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deleted])
}

model Labor {
  id        String   @id @default(cuid()) @db.VarChar(191)
  projectId String   @db.VarChar(191)
  month     String   @db.VarChar(20)
  workerId  String   @db.VarChar(191)
  days      Json?
  ot        Json?
  rate      Float?
  payType   String?  @db.VarChar(50)
  stdDays   Int?     @default(26)
  allowance Float?   @default(0)
  bonus     Float?   @default(0)
  deduction Float?   @default(0)
  payNote   String?  @db.Text
  note      String?  @db.Text
  deleted   Boolean  @default(false)
  createdBy String?  @db.VarChar(191)
  updatedBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, month, deleted])
}

model Advance {
  id        String   @id @default(cuid()) @db.VarChar(191)
  projectId String   @db.VarChar(191)
  kind      String   @default("salary") @db.VarChar(50)
  refId     String?  @db.VarChar(191)
  month     String?  @db.VarChar(20)
  date      String   @db.VarChar(50)
  amount    Float    @default(0)
  method    String?  @db.VarChar(100)
  payer     String?  @db.VarChar(191)
  note      String?  @db.Text
  files     Json?
  deleted   Boolean  @default(false)
  createdBy String?  @db.VarChar(191)
  updatedBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, deleted])
}

model Contract {
  id        String   @id @default(cuid()) @db.VarChar(191)
  projectId String   @db.VarChar(191)
  team      String   @db.VarChar(255)
  leader    String?  @db.VarChar(255)
  phone     String?  @db.VarChar(100)
  items     Json?
  note      String?  @db.Text
  files     Json?
  sort      Int      @default(10)
  deleted   Boolean  @default(false)
  createdBy String?  @db.VarChar(191)
  updatedBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, deleted])
}

model Device {
  id          String   @id @default(cuid()) @db.VarChar(191)
  projectId   String   @db.VarChar(191)
  folderId    String?  @db.VarChar(191)
  category    String?  @db.VarChar(255)
  brand       String?  @db.VarChar(255)
  model       String?  @db.VarChar(255)
  serial      String?  @db.VarChar(255)
  mac         String?  @db.VarChar(100)
  ip          String?  @db.VarChar(100)
  location    String?  @db.VarChar(255)
  installDate String?  @db.VarChar(50)
  installer   String?  @db.VarChar(255)
  status      String   @default("stock") @db.VarChar(50)
  acceptDate  String?  @db.VarChar(50)
  warrantyEnd String?  @db.VarChar(50)
  note        String?  @db.Text
  files       Json?
  sort        Int      @default(10)
  hostname    String?  @db.VarChar(255)
  mask        String?  @db.VarChar(100)
  gateway     String?  @db.VarChar(100)
  vlan        String?  @db.VarChar(50)
  switchName  String?  @db.VarChar(255)
  switchPort  String?  @db.VarChar(50)
  converter   String?  @db.VarChar(255)
  pole        String?  @db.VarChar(255)
  polePort    String?  @db.VarChar(50)
  odfPort     String?  @db.VarChar(50)
  statusLog   Json?
  deleted     Boolean  @default(false)
  createdBy   String?  @db.VarChar(191)
  updatedBy   String?  @db.VarChar(191)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, deleted])
  @@index([serial])
}

model Comment {
  id        String   @id @default(cuid()) @db.VarChar(191)
  taskId    String   @db.VarChar(191)
  projectId String?  @db.VarChar(191)
  text      String?  @db.Text
  files     Json?
  deleted   Boolean  @default(false)
  createdBy String?  @db.VarChar(191)
  updatedBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, deleted])
  @@index([projectId, deleted])
}

model AuditLog {
  id        String   @id @default(cuid()) @db.VarChar(191)
  at        DateTime @default(now())
  user      String?  @db.VarChar(191)
  type      String   @db.VarChar(50)
  recId     String   @db.VarChar(191)
  projectId String?  @db.VarChar(191)
  action    String   @db.VarChar(50)
  title     String?  @db.VarChar(500)
  before    String?  @db.LongText
  after     String?  @db.LongText

  @@index([type, recId])
  @@index([projectId])
  @@index([at])
}

model Notification {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String   @db.VarChar(191)
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(500)
  message   String?  @db.Text
  entityType String? @db.VarChar(50)
  entityId  String?  @db.VarChar(191)
  projectId String?  @db.VarChar(191)
  dueAt     String?  @db.VarChar(50)
  readAt    DateTime?
  deliveryKey String @unique @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([projectId])
}

model PresenceSession {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String   @db.VarChar(191)
  projectId String?  @db.VarChar(191)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([projectId, lastSeen])
}

model BackupArtifact {
  id          String   @id @default(cuid()) @db.VarChar(191)
  filename    String   @db.VarChar(255)
  path        String?  @db.Text
  checksum    String   @db.VarChar(128)
  size        Int      @default(0)
  status      String   @default("completed") @db.VarChar(50)
  createdBy   String?  @db.VarChar(191)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Check {
  id           String   @id @default(cuid()) @db.VarChar(191)
  projectId    String   @db.VarChar(191)
  folderId     String?  @db.VarChar(191)
  name         String   @db.VarChar(255)
  date         String   @db.VarChar(50)
  participants String?  @db.Text
  items        Json?
  conclusion   String?  @db.VarChar(100)
  note         String?  @db.Text
  files        Json?
  deleted      Boolean  @default(false)
  createdBy    String?  @db.VarChar(191)
  updatedBy    String?  @db.VarChar(191)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId, deleted])
}

model Issue {
  id        String   @id @default(cuid()) @db.VarChar(191)
  projectId String   @db.VarChar(191)
  folderId  String?  @db.VarChar(191)
  title     String   @db.VarChar(500)
  location  String?  @db.VarChar(255)
  severity  String   @default("med") @db.VarChar(50)
  assignee  String?  @db.VarChar(191)
  dueDate   String?  @db.VarChar(50)
  status    String   @default("open") @db.VarChar(50)
  note      String?  @db.Text
  files     Json?
  fixedAt   String?  @db.VarChar(50)
  closedBy  String?  @db.VarChar(191)
  deleted   Boolean  @default(false)
  createdBy String?  @db.VarChar(191)
  updatedBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, deleted])
  @@index([status, deleted])
}

model Receipt {
  id             String   @id @default(cuid()) @db.VarChar(191)
  projectId      String   @db.VarChar(191)
  name           String   @db.VarChar(255)
  plannedDate    String?  @db.VarChar(50)
  amount         Float    @default(0)
  status         String   @default("planned") @db.VarChar(50)
  receivedDate   String?  @db.VarChar(50)
  receivedAmount Float?
  note           String?  @db.Text
  files          Json?
  deleted        Boolean  @default(false)
  createdBy      String?  @db.VarChar(191)
  updatedBy      String?  @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, deleted])
}

model Guarantee {
  id         String   @id @default(cuid()) @db.VarChar(191)
  projectId  String   @db.VarChar(191)
  gtype      String   @default("other") @db.VarChar(50)
  bank       String?  @db.VarChar(255)
  number     String?  @db.VarChar(100)
  amount     Float    @default(0)
  issueDate  String?  @db.VarChar(50)
  expiryDate String?  @db.VarChar(50)
  status     String   @default("active") @db.VarChar(50)
  note       String?  @db.Text
  files      Json?
  deleted    Boolean  @default(false)
  createdBy  String?  @db.VarChar(191)
  updatedBy  String?  @db.VarChar(191)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId, deleted])
  @@index([expiryDate])
}

model NetlabTopology {
  id        String   @id @default(cuid()) @db.VarChar(191)
  projectId String   @unique @db.VarChar(191)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  data      Json
  updatedBy String?  @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}
